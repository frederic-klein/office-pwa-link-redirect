{
  "manifest_version": 3,
  "name": "Link Opener",
  "version": "2.0.0",
  "description": "Open links in the default browser",
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
